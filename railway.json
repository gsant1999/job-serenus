{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "python3 init_production.py && gunicorn -w 1 --threads 4 --max-requests 2000 --max-requests-jitter 200 -b 0.0.0.0:$PORT --timeout 300 app:app",
    "restartPolicyMaxRetries": 3,
    "restartPolicyWindowSeconds": 600
  },
  "volumes": [
    {
      "name": "data",
      "mountPath": "/data",
      "size": "10GB"
    }
  ]
}
