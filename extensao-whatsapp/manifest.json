{
  "manifest_version": 3,
  "name": "JOB — Análise de WhatsApp",
  "version": "4.82.0",
  "description": "Painel dentro do WhatsApp Web: analisa o lead, calcula o Score e envia mensagens da biblioteca de modelos.",
  "permissions": [
    "notifications",
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.up.railway.app/*",
    "https://job-serenus-production.up.railway.app/*",
    "https://paineldocorretor.com.br/*",
    "https://*.paineldocorretor.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JOB — Análise de WhatsApp"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "injetor.js",
        "logo_arcos.png",
        "logos/amhemed.png",
        "logos/fenix-medical.png",
        "logos/salusmed.png",
        "logos/samp.png",
        "logos/santa-tereza.png",
        "logos/select.png",
        "logos/vera-cruz.png",
        "wa-js.vendor.js",
        "wpp-bridge.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    },
    {
      "resources": [
        "cotador-painel.js"
      ],
      "matches": [
        "https://paineldocorretor.com.br/*",
        "https://*.paineldocorretor.com.br/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://job-serenus-production.up.railway.app/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://paineldocorretor.com.br/*",
        "https://*.paineldocorretor.com.br/*"
      ],
      "js": [
        "painel-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
