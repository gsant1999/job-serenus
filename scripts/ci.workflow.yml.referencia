# CÓPIA DE REFERÊNCIA do .github/workflows/ci.yml
#
# O arquivo de verdade vive no GitHub e foi criado pela interface: o token desta
# máquina não tem escopo `workflow`, e qualquer push que inclua um arquivo em
# .github/workflows/ é recusado INTEIRO — travando trabalho que não tem nada a
# ver com ele. Por isso `.github/` está no .gitignore.
#
# Esta cópia existe para: comparar quando algo mudar, e não depender da memória
# de ninguém. Se alterar o workflow no GitHub, atualize este arquivo também —
# duas versões divergindo em silêncio é pior que uma só.
#
# ─────────────────────────────────────────────────────────────────────────────

# QUATRO PERGUNTAS ANTES DE QUALQUER COISA SUBIR.
#
# Nao e cobertura de teste. Sao as quatro verificacoes que teriam pego os tres
# defeitos de 09/08/2026 — o dia em que o app nao subia, o botao de sair virou
# pagina de admin e 46 funcoes da extensao sumiram num recorte por linha.
# Nenhum dos tres foi pego por ferramenta; os tres foram pegos por alguem
# olhando a tela. E isso que nao escala para dez corretoras.
#
# Roda em SQLite, com JOB_DATA_DIR temporario. NENHUM segredo entra aqui: se um
# teste precisar de chave de verdade, o teste esta errado.
name: CI

on:
  push:
    branches: ['**']
  pull_request:

jobs:
  verificacoes:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: pip

      - name: Instalar dependencias
        run: pip install -r requirements.txt

      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      # 1, 2 e 3 — o app sobe; nenhuma rota esta no lugar errado; as rotas
      # criticas respondem o status certo com e sem credencial.
      - name: O servidor
        env:
          JOB_DATA_DIR: /tmp/ci-job
          WHATSAPP_EXT_KEY: chave-de-teste-do-ci
          SECRET_KEY: ci
        run: python scripts/ci_servidor.py

      # 4 — a extensao compila e esta completa.
      - name: A extensao compila
        run: bash scripts/checar_extensao.sh

      - name: Os arquivos do manifest existem
        run: python scripts/ci_extensao_arquivos.py
